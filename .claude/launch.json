        "--host",
        "0.0.0.0"
      ],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
