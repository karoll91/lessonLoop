{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "D:/php83/php.exe",
      "runtimeArgs": [
        "backend/artisan",
        "serve",
        "--host=0.0.0.0",
        "--port=8000"
      ],
      "port": 8000
    },
    {
