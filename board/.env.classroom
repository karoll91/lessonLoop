# Used by deploy/build.ps1 (vite build --mode classroom).
# Empty = the host and port the page was opened from, so one build works on
# any IP; the web server passes /app/ (the WebSocket) on to Reverb.
# VITE_REVERB_APP_KEY comes from backend/.env.
VITE_API_URL=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_BOARD_NAME=
