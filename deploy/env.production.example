# Values to change in backend/.env on the classroom server.
# After editing .env restart the server (deploy\stop.bat, deploy\start.bat):
# Config is not cached, so .env changes apply after a restart.

APP_ENV=production
APP_DEBUG=false
# This computer's IP in the classroom network and the HttpPort from deploy/config.ps1.
APP_URL=http://192.168.1.10:8000

LOG_LEVEL=warning

# MySQL from OpenServer. Set a password for root (or a separate user) in
# production and put it here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lessonloop
DB_USERNAME=root
DB_PASSWORD=

# Reverb: the server listens on 8080; Laravel reaches it on this computer.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Optional (defaults shown):
# LESSONLOOP_BACKUP_DIR=D:\LessonLoop-backups      (default: backend/storage/app/backups)
# LESSONLOOP_BACKUP_DAYS=30
# LESSONLOOP_MYSQLDUMP=D:\OSPanel\modules\database\MySQL-8.0-Win10\bin\mysqldump.exe
# LESSONLOOP_CONTROLLER_TIMEOUT=45
# LESSONLOOP_BOARD_PRUNE_HOURS=24
