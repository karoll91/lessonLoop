# LessonLoop classroom server. Rendered by deploy/start.ps1 into
# deploy/runtime/conf/nginx.conf — edit this template, not the copy.
#   :{{HTTP_PORT}}/api/…   Laravel API (PHP 8.3 FastCGI workers)
#   :{{HTTP_PORT}}/admin/  admin panel (backend/public/admin)
#   :{{HTTP_PORT}}/board/  classroom board (backend/public/board)

worker_processes  1;
error_log  logs/error.log warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       "{{DEPLOY}}/nginx/mime.types";
    default_type  application/octet-stream;
    charset       utf-8;
    sendfile      on;
    keepalive_timeout  65;
    client_max_body_size  20m;
    server_tokens off;
    access_log    off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    upstream php {
{{PHP_UPSTREAMS}}
    }

    server {
        listen       {{HTTP_PORT}};
        server_name  _;
        root         "{{ROOT}}/backend/public";
        index        index.php;

        # Everything lives in backend/public: admin/ and board/ (built by
        # build.bat), docs/ (Scribe). The rest, and admin panel addresses after
        # a reload, go to Laravel (routes/web.php, routes/api.php).
        location / {
            index index.html index.php;
            try_files $uri $uri/ /index.php?$query_string;
        }

        # Built files have hashed names and never change.
        location ~ ^/(admin|board)/assets/ {
            expires 30d;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass   php;
            fastcgi_index  index.php;
            fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
            include        "{{DEPLOY}}/nginx/fastcgi_params";
            fastcgi_read_timeout 300;
            fastcgi_next_upstream error timeout;
        }

        location ~ /\.(?!well-known) {
            deny all;
        }
    }
}
