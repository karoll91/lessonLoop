types {
    text/html                    html htm;
    text/css                     css;
    text/plain                   txt;
    application/javascript       js mjs;
    application/json             json map;
    application/manifest+json    webmanifest;
    image/svg+xml                svg svgz;
    image/png                    png;
    image/jpeg                   jpeg jpg;
    image/gif                    gif;
    image/webp                   webp;
    image/x-icon                 ico;
    font/woff                    woff;
    font/woff2                   woff2;
    font/ttf                     ttf;
    application/pdf              pdf;
    application/zip              zip;
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet  xlsx;
    text/csv                     csv;
}
